# k8s/overlays/staging/auth.env — auth-server (staging). Managed ElastiCache +
# CNPG. Secret creds via 'backend-creds' (REDIS_PASSWORD); DATABASE_URL from the
# CNPG staging-auth-postgres-app secret (see patch-auth-db.yaml). The ES256
# SIGNING PEMs + Keycloak client secrets are sensitive -> injected from the
# 'auth-secrets' ExternalSecret (see external-secrets.yaml), NOT this ConfigMap.

# ── PostgreSQL session/issuance store (CNPG; DATABASE_URL via patch) ───────────
PG_TOPOLOGY=single

# ── Redis (managed ElastiCache, cluster mode + TLS) ───────────────────────────
REDIS_HOSTS=${ELASTICACHE_CONFIG_ENDPOINT}:6379
REDIS_TOPOLOGY=cluster
# ElastiCache enforces transit encryption; without TLS every command times out.
REDIS_TLS=true

# ── Token issuance (ES256 edge tokens) ────────────────────────────────────────
AUTH_TOKEN_ISSUER=https://auth.core-platform.click
AUTH_TOKEN_AUDIENCE=core-platform
AUTH_SIGNING_KID=staging-es256-1
AUTH_ACCESS_TTL_SECS=900
AUTH_REFRESH_TTL_SECS=2592000
AUTH_SESSION_TTL_SECS=2592000
AUTH_ABSOLUTE_TTL_SECS=7776000

# ── Downstream + federated IdP (Keycloak). Client secret via auth-secrets. ─────
AUTH_ACCOUNT_GRPC_ENDPOINT=http://staging-account-server:50059
# The profiles an account owns are minted into the edge token (`pids` claim)
# so client-facing services can bind profile-keyed actors to the caller.
AUTH_PROFILE_GRPC_ENDPOINT=http://staging-profile-server:50052
AUTH_KEYCLOAK_TOKEN_ENDPOINT=${KEYCLOAK_TOKEN_ENDPOINT}
AUTH_KEYCLOAK_CLIENT_ID=core-platform-auth
AUTH_KEYCLOAK_SCOPE=openid
# Credential management (ChangePassword / VerifyCredentials) through the realm
# Admin API, as the core-platform-auth-admin service account (client_credentials
# on the token endpoint above; secret via auth-secrets). Empty URL -> those RPCs
# answer UNAVAILABLE.
AUTH_KEYCLOAK_ADMIN_URL=${KEYCLOAK_ADMIN_URL}
AUTH_KEYCLOAK_ADMIN_CLIENT_ID=core-platform-auth-admin

# ── Guest mode (B5a) ──────────────────────────────────────────────────────────
# StartGuestSession mints a session with no credential; it is only safe behind
# the client-edge per-IP limit (`guest-start` in infrastructure.toml). STAGING
# ONLY: prod stays off until App Attest (B5b) ships and a review is done.
AUTH_GUEST_SESSIONS_ENABLED=true

# ── Native Sign in with Apple / Google (B4a) ──────────────────────────────────
# The client ids an id_token must be minted for (`aud`), comma-separated. Not
# secrets. Empty = that provider is off (SignUp / id_token Login answer AUT-5009).
# Apple: the iOS app's bundle id (team 4ZZ7J5Z8ZX); add the Services ID here if
# web sign-in is ever added. Google: off until the Google OAuth iOS client exists.
AUTH_APPLE_AUDIENCES=cn.wynn.core-platform-ios
AUTH_GOOGLE_AUDIENCES=
# AUTH_FEDERATED_JWKS_TIMEOUT_MS=3000 (default)

# ── One-time codes by email: Amazon SES SMTP (B4b) ───────────────────────────
# StartVerification sends passwordless sign-up / sign-in codes. SES identity:
# core-platform.click (global/messaging/ses-identity, DKIM + MAIL FROM + DMARC).
# AUTH_SMTP_USERNAME / AUTH_SMTP_PASSWORD come from the `auth-smtp` secret (ESO).
# While the SES account is in the sandbox, only verified recipients get mail.
# NEVER set AUTH_VERIFICATION_SENDER=log in a deployed env: it logs the codes.
AUTH_VERIFICATION_SENDER=smtp
AUTH_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
AUTH_SMTP_PORT=587
# The address must match ses_from_address (modules/app-secrets): the SMTP user
# may only send as it.
AUTH_SMTP_FROM=Core Platform <no-reply@core-platform.click>
# Defaults: AUTH_VERIFICATION_TTL_SECS=600, _MAX_ATTEMPTS=5, _PER_HOUR=5, _RESEND_SECS=30

# ── One-time codes by SMS: Amazon SNS (B4c, phone-only accounts) ─────────────
# Account guardrails: global/messaging/sms (spend limit + alarms, country
# allow-list via the account-default protect configuration). Keys come from the
# `auth-sns` secret (ESO). AUTH_SNS_REGION alone does not send anything.
AUTH_SNS_REGION=us-east-1
AUTH_SMS_SENDER=sns
# Toll-fraud brakes in auth (core-platform-backend#732), on top of the per-IP
# `verification` edge limit and the SNS account limits:
#   * destinations: MUST equal `allowed_countries` in
#     infrastructure/live/global/messaging/sms (SNS blocks the rest anyway, but
#     auth must reject them up front, AUT-5015, instead of failing at send);
AUTH_SMS_COUNTRIES=AT,BE,BG,CY,CZ,DE,DK,EE,ES,FI,FR,GR,HR,HU,IE,IT,LT,LU,LV,MT,NL,PL,PT,RO,SE,SI,SK,IS,LI,NO,GB,CH,GP,GF,MQ,RE,YT
#   * service-wide SMS per UTC day (AUT-5016 past it). Sized on the SNS monthly
#     limit: 20 USD / 30 days / ~0.08 USD per SMS ≈ 8. Raise both together.
AUTH_SMS_DAILY_BUDGET=8
# Still pending before the SNS account leaves the SMS sandbox (until then only
# verified numbers receive anything): App Attest gating (B5b).
# Optional, where the destination country allows alphanumeric sender ids:
# AUTH_SNS_SENDER_ID=<brand>

# ── Observability ─────────────────────────────────────────────────────────────
RUST_LOG=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4317

# ── Kafka (managed MSK, SASL/SCRAM over TLS; creds via backend-creds) ─────────
# Auth PRODUCES session/login events; without these the client fell back to its
# localhost:9092 default and Login RPCs hung on the first publish (found by the
# prod E2E drill — boot health never touches Kafka, so the pod looked Ready).
KAFKA_BROKERS=${MSK_BOOTSTRAP_BROKERS_SASL_SCRAM}
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
