# k8s/overlays/staging/post.env — staging (noredis). Managed MSK/ElastiCache +
# in-cluster Scylla (operator) / CNPG. Secret values (KAFKA_SASL_*/REDIS_PASSWORD/
# DATABASE_URL) come from the 'backend-creds' Secret synced by External Secrets;
# <<…>> endpoints are filled at deploy from the Terraform data-store outputs.

# ── ScyllaDB (in-cluster scylla-operator ScyllaCluster) ───────────────────────
SCYLLA_CONTACT_POINTS=scylla-client.scylla.svc.cluster.local:9042
SCYLLA_LOCAL_DC=datacenter1
SCYLLA_KEYSPACE=post

# ── Kafka (managed MSK, SASL/SCRAM over TLS; creds via backend-creds) ─────────
KAFKA_BROKERS=${MSK_BOOTSTRAP_BROKERS_SASL_SCRAM}
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512

# ── Audience check (social-graph CheckAccess, mesh-only) ──────────────────────
# Non-author post reads fail closed (UNAVAILABLE) when social-graph does not
# answer — see core-platform-backend post README.
POST_SOCIAL_GRAPH_GRPC_ENDPOINT=http://staging-social-graph-server:50053

# ── Mesh: media (attachment assets, core-platform-infra#88, backend #907) ─────
# GetAsset on write (the asset must be the author's own post image/video),
# BatchResolveDelivery on read (blurhash, renditions), ChangeDeliveryVisibility
# for private authors (#919; media's mesh gate takes it from post-server and
# chat-server only, so post sends its projected token, patch-mesh-caller-token).
# Unset = asset ids dropped, attachments keep their URLs.
POST_MEDIA_GRPC_ENDPOINT=http://staging-media-server:50063
# POST_MEDIA_RPC_TIMEOUT_MS=300, POST_MEDIA_CONNECT_TIMEOUT_MS=1000 (defaults)

# ── Observability ─────────────────────────────────────────────────────────────
RUST_LOG=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4317
