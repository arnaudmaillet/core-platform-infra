# k8s/overlays/staging/media.env — media-server + media-worker (staging). Managed MSK/ElastiCache
# + CNPG + S3. DATABASE_URL via the CNPG staging-media-postgres-app secret (patch).
#
# NB credentials: the S3 client is rusty-s3 with STATIC keys (MEDIA_S3_ACCESS_KEY/
# MEDIA_S3_SECRET_KEY), injected from the 'media-s3-creds' ExternalSecret — it does
# NOT use the IRSA role on the SA (see Block 4/5 notes). Bucket/region/endpoint are
# non-secret config and live here.

# ── PostgreSQL asset-lifecycle SoR (CNPG; DATABASE_URL via patch) ─────────────
PG_TOPOLOGY=single

# ── Redis hot cache (managed ElastiCache) ─────────────────────────────────────
REDIS_HOSTS=${ELASTICACHE_CONFIG_ENDPOINT}:6379
REDIS_TOPOLOGY=cluster
# ElastiCache enforces transit encryption; without TLS every command times out.
REDIS_TLS=true

# ── Kafka transform pipeline (managed MSK, SASL/SCRAM over TLS) ───────────────
KAFKA_BROKERS=${MSK_BOOTSTRAP_BROKERS_SASL_SCRAM}
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512

# ── S3 object store (real AWS S3 via rusty-s3 SigV4; keys via media-s3-creds) ──
MEDIA_OBJECT_STORE_BUCKET=core-platform-staging-media-724772065879
MEDIA_OBJECT_STORE_ENDPOINT=https://s3.us-east-1.amazonaws.com
MEDIA_OBJECT_STORE_REGION=us-east-1

# ── Delivery + screening ──────────────────────────────────────────────────────
# PUBLIC deliveries: CloudFront with OAC in front of the bucket
# (networking/media-cdn). Never serves quarantine/, uploads/, private/ or
# restricted/ (non-public renditions, #56; unused until media writes there).
MEDIA_CDN_BASE_URL=https://media-staging.core-platform.click
# Takedown purge: invalidates a taken-down asset's CDN copies. A failed purge
# fails the takedown, which is retried. From the CMP; a literal ${…} here means
# kubernetes/argocd was not re-applied after networking/media-cdn.
MEDIA_CLOUDFRONT_DISTRIBUTION_ID=${MEDIA_CLOUDFRONT_DISTRIBUTION_ID}
# Verification evidence (MEDIA_KIND_PRIVATE_DOCUMENT, under private/): on in
# the same change that keeps private/* out of the CDN's origin access (#37).
# Staff read a document only through the mesh-only GetPrivateDocumentUrl
# (short-lived S3 presign); media's ingress is restricted to its mesh callers.
MEDIA_PRIVATE_DOCUMENTS_ENABLED=true
# MEDIA_DOCUMENT_RETENTION_DAYS=30, MEDIA_DOCUMENT_SWEEP_INTERVAL_SECS=3600 (defaults)
MEDIA_SCREEN_GRPC_ENDPOINT=http://staging-moderation-server:50061
MEDIA_DEDUP_ENABLED=false

# ── Mesh caller gate (core-platform-infra#88/#89, backend #919/#852) ──────────
# ChangeDeliveryVisibility moves an asset's objects, so media checks WHICH
# service calls it (post-server, chat-server) from the caller's projected
# ServiceAccount token (x-mesh-token). Same verifier as moderation/wallet: JWKS
# in-cluster with this pod's own token (mesh-identity-rbac.yaml). log = a
# mismatch is only logged ("mesh caller refused"); enforce once post and chat
# run clean.
MESH_CALLER_GATE=log
MESH_TOKEN_ISSUER=${MESH_TOKEN_ISSUER}
MESH_TOKEN_AUDIENCE=core-platform-mesh
# Callers must run in this namespace: the fleet's ArgoCD destination
# (infrastructure/argocd/apps/deployments/<env>/fleet.yaml). Explicit rather than
# the mounted-namespace fallback: without that file the gate lets any namespace pass.
MESH_NAMESPACE=default
MESH_JWKS_URL=https://kubernetes.default.svc/openid/v1/jwks
MESH_JWKS_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
MESH_JWKS_BEARER_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token

# ── Observability ─────────────────────────────────────────────────────────────
RUST_LOG=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4317
