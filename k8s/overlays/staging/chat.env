# k8s/overlays/staging/chat.env — staging (standard). Managed MSK/ElastiCache +
# in-cluster Scylla (operator) / CNPG. Secret values (KAFKA_SASL_*/REDIS_PASSWORD/
# DATABASE_URL) come from the 'backend-creds' Secret synced by External Secrets;
# <<…>> endpoints are filled at deploy from the Terraform data-store outputs.

# ── ScyllaDB (in-cluster scylla-operator ScyllaCluster) ───────────────────────
SCYLLA_CONTACT_POINTS=scylla-client.scylla.svc.cluster.local:9042
SCYLLA_LOCAL_DC=datacenter1
SCYLLA_KEYSPACE=chat

# ── Kafka (managed MSK, SASL/SCRAM over TLS; creds via backend-creds) ─────────
KAFKA_BROKERS=${MSK_BOOTSTRAP_BROKERS_SASL_SCRAM}
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512

# ── Redis (managed ElastiCache, cluster mode + TLS; password via backend-creds) ─
REDIS_HOSTS=${ELASTICACHE_CONFIG_ENDPOINT}:6379
REDIS_TOPOLOGY=cluster
# ElastiCache enforces transit encryption; without TLS every command times out.
REDIS_TLS=true

# ── Observability ─────────────────────────────────────────────────────────────
RUST_LOG=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4317

# ── Mesh: social-graph (direct messages, core-platform-backend#795) ──────────
# CheckInteraction(MESSAGE) on opening a DM, on every direct message and on group
# invitations. Unset = DMs off (CHT-5001). Unreachable = DMs and invitations
# fail closed (UNAVAILABLE); groups and channels are unaffected.
CHAT_SOCIAL_GRAPH_GRPC_ENDPOINT=http://staging-social-graph-server:50053

# ── Mesh: media (message media, core-platform-infra#89, backend #928) ─────────
# GetAsset + ChangeDeliveryVisibility on send (a message's media goes SIGNED;
# media's mesh gate takes that from post-server and chat-server only, so chat
# sends its projected token, patch-mesh-caller-token), BatchResolveDelivery on
# GetHistory. Unset = asset ids dropped, messages keep their media_ref.
CHAT_MEDIA_GRPC_ENDPOINT=http://staging-media-server:50063
# CHAT_MEDIA_RPC_TIMEOUT_MS=300, CHAT_MEDIA_CONNECT_TIMEOUT_MS=1000 (defaults)
