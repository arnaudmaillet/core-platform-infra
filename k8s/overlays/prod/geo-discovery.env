# k8s/overlays/prod/geo-discovery.env — prod (standard). Managed MSK/ElastiCache +
# in-cluster Scylla (operator) / CNPG. Secret values (KAFKA_SASL_*/REDIS_PASSWORD/
# DATABASE_URL) come from the 'backend-creds' Secret synced by External Secrets;
# <<…>> endpoints are filled at deploy from the Terraform data-store outputs.

# ── ScyllaDB (in-cluster scylla-operator ScyllaCluster) ───────────────────────
SCYLLA_CONTACT_POINTS=scylla-client.scylla.svc.cluster.local:9042
SCYLLA_LOCAL_DC=datacenter1
SCYLLA_KEYSPACE=geo_discovery

# ── Kafka (managed MSK, SASL/SCRAM over TLS; creds via backend-creds) ─────────
KAFKA_BROKERS=${MSK_BOOTSTRAP_BROKERS_SASL_SCRAM}
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512

# ── Redis (managed ElastiCache, cluster mode + TLS; password via backend-creds) ─
REDIS_HOSTS=${ELASTICACHE_CONFIG_ENDPOINT}:6379
REDIS_TOPOLOGY=cluster
# ElastiCache enforces transit encryption; without TLS every command times out.
REDIS_TLS=true

# ── Per-reader audience filter (social-graph CheckAccess, mesh-only) ──────────
# Client map reads (QueryTile / GetGeoTimeline) fail closed (UNAVAILABLE)
# without it — see core-platform-backend geo-discovery README.
GEO_SOCIAL_GRAPH_GRPC_ENDPOINT=http://prod-social-graph-server:50053

# ── Observability ─────────────────────────────────────────────────────────────
RUST_LOG=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4317

# ── Country unlocks: wallet + account mesh routes (core-platform-infra#42) ────
# Gems are read (GetWallet) and spent (SpendGems, mesh-only) on wallet; the
# member's home country comes from account (GetAccountById). Until wallet is up,
# GetCountryUnlocks / UnlockCountry answer GEO-6002 (fail-closed); maps and the
# ladder are unaffected.
GEO_WALLET_GRPC_ENDPOINT=http://prod-wallet-server:50072
GEO_ACCOUNT_GRPC_ENDPOINT=http://prod-account-server:50059
# Member map filter (only home + unlocked countries): OFF until the iOS shop is
# wired to the server, a product call. Set to true then.
# GEO_COUNTRY_UNLOCKS_ENABLED=true
