# k8s/overlays/prod/moderation.env — moderation-server (prod). Managed
# MSK/ElastiCache + in-cluster Scylla (operator) / CNPG. Secret creds via
# 'backend-creds'; DATABASE_URL from the CNPG prod-moderation-postgres-app
# secret (see patch-moderation-db.yaml).

# ── PostgreSQL decision/enforcement SoR (CNPG; DATABASE_URL via patch) ─────────
PG_TOPOLOGY=single

# ── ScyllaDB append-only history feed (in-cluster ScyllaCluster) ──────────────
SCYLLA_CONTACT_POINTS=scylla-client.scylla.svc.cluster.local:9042
SCYLLA_LOCAL_DC=datacenter1
SCYLLA_KEYSPACE=moderation

# ── Redis hot-read enforcement cache (managed ElastiCache) ────────────────────
REDIS_HOSTS=${ELASTICACHE_CONFIG_ENDPOINT}:6379
REDIS_TOPOLOGY=cluster
# ElastiCache enforces transit encryption; without TLS every command times out.
REDIS_TLS=true

# ── Kafka (managed MSK, SASL/SCRAM over TLS) ──────────────────────────────────
KAFKA_BROKERS=${MSK_BOOTSTRAP_BROKERS_SASL_SCRAM}
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512

# ── Downstream dependency (account enforcement application) ────────────────────
MODERATION_ACCOUNT_GRPC_ENDPOINT=http://prod-account-server:50059

# ── Client reports (SubmitReport): whose content a report targets ─────────────
# post / comment → author profile → owning account, resolved server-side.
MODERATION_POST_GRPC_ENDPOINT=http://prod-post-server:50056
MODERATION_COMMENT_GRPC_ENDPOINT=http://prod-comment-server:50057
MODERATION_PROFILE_GRPC_ENDPOINT=http://prod-profile-server:50052

# ── Mesh caller gate (core-platform-infra#62, backend #852/#871) ─────────────
# Sensitive mesh-only RPCs check WHICH service calls, from the caller's
# projected ServiceAccount token (x-mesh-token): RS256, the cluster's issuer,
# audience core-platform-mesh. JWKS fetched in-cluster from the API server with
# this pod's own token (RBAC: mesh-identity-rbac.yaml). log = a mismatch is only
# logged ("mesh caller refused"); switch to enforce once account (export,
# supervision reports) and geo-discovery (country unlocks) run clean.
MESH_CALLER_GATE=log
MESH_TOKEN_ISSUER=${MESH_TOKEN_ISSUER}
MESH_TOKEN_AUDIENCE=core-platform-mesh
MESH_JWKS_URL=https://kubernetes.default.svc/openid/v1/jwks
MESH_JWKS_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
MESH_JWKS_BEARER_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token

# ── Observability ─────────────────────────────────────────────────────────────
RUST_LOG=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4317
