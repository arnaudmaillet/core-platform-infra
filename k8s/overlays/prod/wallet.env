# k8s/overlays/prod/wallet.env — wallet-server (prod). The in-app economy ledger
# (core-platform-backend #665): points (likes are points) and gems, per account.
# TIER-0, fail-closed. DATABASE_URL from the CNPG prod-wallet-postgres-app
# secret (patch-wallet-db.yaml); Kafka creds from 'backend-creds'.

# ── PostgreSQL (in-cluster CNPG; DATABASE_URL via patch) ──────────────────────
PG_TOPOLOGY=single

# ── Kafka (managed MSK, SASL/SCRAM over TLS; creds via backend-creds) ─────────
# REQUIRED: wallet refuses to start without KAFKA_BROKERS (a stake's event would
# be lost). Produces wallet.v1.events (transactional outbox), consumes
# account.v1.events (group wallet-account-events: a deleted account's wallet is
# erased). NEVER set WALLET_ALLOW_LOG_PUBLISHER here (local runs only).
KAFKA_BROKERS=${MSK_BOOTSTRAP_BROKERS_SASL_SCRAM}
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512

# ── Mesh callees (their defaults are localhost: these MUST be set) ────────────
# A like (Stake) checks its target exists (post / comment) and is visible to
# the one who likes (social-graph). engagement: stake settlement (shadow mode);
# unset would settle nothing.
WALLET_POST_GRPC_ENDPOINT=http://prod-post-server:50056
WALLET_COMMENT_GRPC_ENDPOINT=http://prod-comment-server:50057
WALLET_SOCIAL_GRAPH_GRPC_ENDPOINT=http://prod-social-graph-server:50053
WALLET_ENGAGEMENT_GRPC_ENDPOINT=http://prod-engagement-server:50058

# ── Product rules: the backend defaults are the product's (README §config) ────
# WALLET_CLAIM_INTERVAL_SECS=3600, WALLET_CLAIM_BASE_POINTS=25,
# WALLET_DAILY_CLAIM_CAP=200, WALLET_STARTER_GEMS=100,
# WALLET_STAKE_TARGET_CAP=250, WALLET_STAKE_HOURLY_CAP=1000, …

# ── Mesh caller gate (core-platform-infra#62, backend #852/#871) ─────────────
# Sensitive mesh-only RPCs check WHICH service calls, from the caller's
# projected ServiceAccount token (x-mesh-token): RS256, the cluster's issuer,
# audience core-platform-mesh. JWKS fetched in-cluster from the API server with
# this pod's own token (RBAC: mesh-identity-rbac.yaml). log = a mismatch is only
# logged ("mesh caller refused"); switch to enforce once account (export,
# supervision reports) and geo-discovery (country unlocks) run clean.
MESH_CALLER_GATE=log
MESH_TOKEN_ISSUER=${MESH_TOKEN_ISSUER}
MESH_TOKEN_AUDIENCE=core-platform-mesh
MESH_JWKS_URL=https://kubernetes.default.svc/openid/v1/jwks
MESH_JWKS_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
MESH_JWKS_BEARER_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token

# ── Observability ─────────────────────────────────────────────────────────────
RUST_LOG=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4317
