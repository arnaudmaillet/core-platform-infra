# k8s/overlays/prod/account.env — prod (postgres). Managed MSK/ElastiCache +
# in-cluster Scylla (operator) / CNPG. Secret values (KAFKA_SASL_*/REDIS_PASSWORD/
# DATABASE_URL) come from the 'backend-creds' Secret synced by External Secrets;
# <<…>> endpoints are filled at deploy from the Terraform data-store outputs.

# ── PostgreSQL (in-cluster CNPG; DATABASE_URL from the cluster secret, see patch) ─
PG_TOPOLOGY=single

# ── Observability ─────────────────────────────────────────────────────────────
RUST_LOG=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4317

# ── Step-up on destructive self-service (DeactivateAccount / RequestGdprDeletion) ─
# flip to true once the iOS app calls auth.v1.VerifyCredentials before
# deleting/deactivating
ACCOUNT_REQUIRE_STEP_UP=false

# ── Mesh callees ──────────────────────────────────────────────────────────────
# profile + social-graph: FindProfilesByContacts (address-book matching, edge
# RPC, needed as soon as account ships). All of them: the GDPR data export pass
# (core-platform-infra#28/#34), which stays off until ACCOUNT_EXPORT_BUCKET is
# set; a missing endpoint leaves that archive section pending, never partial.
# moderation: a supervised teen's reports for their supervisor (#40).
ACCOUNT_PROFILE_GRPC_ENDPOINT=http://prod-profile-server:50052
ACCOUNT_SOCIAL_GRAPH_GRPC_ENDPOINT=http://prod-social-graph-server:50053
ACCOUNT_POST_GRPC_ENDPOINT=http://prod-post-server:50056
ACCOUNT_COMMENT_GRPC_ENDPOINT=http://prod-comment-server:50057
ACCOUNT_ENGAGEMENT_GRPC_ENDPOINT=http://prod-engagement-server:50058
ACCOUNT_CHAT_GRPC_ENDPOINT=http://prod-chat-server:50051
ACCOUNT_MEDIA_GRPC_ENDPOINT=http://prod-media-server:50063
ACCOUNT_SEARCH_GRPC_ENDPOINT=http://prod-search-server:50062
ACCOUNT_MODERATION_GRPC_ENDPOINT=http://prod-moderation-server:50061
